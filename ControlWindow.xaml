<Window x:Class="EQMobOverlay.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQ Mob Overlay"
        Width="500" Height="360"
        MinWidth="460" MinHeight="330"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="EQ Mob Overlay" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="The overlay auto-detects EQ, or you can select a running eqgame.exe manually."
                       Margin="0,4,0,0" Foreground="#FF666666" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
                <TextBlock Text="EverQuest process" FontWeight="SemiBold"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProcessList" MinHeight="30" VerticalContentAlignment="Center"/>
                    <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Margin="8,0,0,0" Padding="14,5"
                            Click="RefreshButton_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="SelectButton" Content="Use selected EQ" Padding="14,5" Click="SelectButton_Click"/>
                    <Button x:Name="AutoButton" Content="Auto Detect" Margin="8,0,0,0" Padding="14,5" Click="AutoButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="ProcessHelp" Margin="0,7,0,0" Foreground="#FF777777" TextWrapping="Wrap"
                           Text="If more than one EQ client is running, select the one you want by PID."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
                <CheckBox x:Name="OverlayEnabledCheck" Content="Show mob overlay while the selected EQ window is active"
                          IsChecked="True" Checked="OverlayEnabledCheck_Changed" Unchecked="OverlayEnabledCheck_Changed"/>
                <TextBlock Margin="0,8,0,0" Foreground="#FF666666" TextWrapping="Wrap">
                    The mob panel stays constrained to the selected EverQuest client area. The control window remains available from the taskbar and system tray.
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="6" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Connection" FontWeight="SemiBold"/>
                <TextBlock x:Name="ConnectionStatus" Grid.Column="1" Text="Starting…" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2" Text="Target" FontWeight="SemiBold"/>
                <TextBlock x:Name="TargetStatus" Grid.Row="2" Grid.Column="1" Text="—" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="4" Text="NPC database" FontWeight="SemiBold"/>
                <TextBlock x:Name="DatabaseStatus" Grid.Row="4" Grid.Column="1" Text="Starting…" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
