<Window x:Class="EQMobOverlay.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQ Mob Overlay"
        Width="520" Height="560"
        MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="EQ Mob Overlay" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Auto-detect EQ, select a window, or enter the client PID manually."
                       Margin="0,4,0,0" Foreground="#FF666666" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
                <TextBlock Text="EverQuest window / process" FontWeight="SemiBold"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProcessList" MinHeight="30" VerticalContentAlignment="Center"/>
                    <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Margin="8,0,0,0" Padding="14,5"
                            Click="RefreshButton_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="SelectButton" Content="Use selected window" Padding="14,5" Click="SelectButton_Click"/>
                    <Button x:Name="AutoButton" Content="Auto Detect" Margin="8,0,0,0" Padding="14,5" Click="AutoButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="ProcessHelp" Margin="0,7,0,0" Foreground="#FF777777" TextWrapping="Wrap"
                           Text="Choose EverQuest/Quarm by process name, title, or PID."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
                <TextBlock Text="Manual PID" FontWeight="SemiBold"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PidBox" MinHeight="30" VerticalContentAlignment="Center"
                             ToolTip="Find the PID in Task Manager > Details"/>
                    <Button x:Name="UsePidButton" Grid.Column="1" Content="Attach to PID" Margin="8,0,0,0" Padding="14,5"
                            Click="UsePidButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="6" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
                <TextBlock Text="Overlay behaviour" FontWeight="SemiBold"/>
                <CheckBox x:Name="OverlayEnabledCheck" Content="Show mob overlay"
                          Margin="0,8,0,0" IsChecked="True"
                          Checked="OverlayEnabledCheck_Changed" Unchecked="OverlayEnabledCheck_Changed"/>
                <CheckBox x:Name="KeepVisibleCheck" Content="Keep overlay visible when EQ is not the foreground window"
                          Margin="0,7,0,0" IsChecked="True"
                          Checked="KeepVisibleCheck_Changed" Unchecked="KeepVisibleCheck_Changed"/>
                <CheckBox x:Name="LockOverlayCheck" Content="Lock overlay position and size (click-through)"
                          Margin="0,7,0,0" IsChecked="True"
                          Checked="LockOverlayCheck_Changed" Unchecked="LockOverlayCheck_Changed"/>
                <TextBlock Margin="0,7,0,0" Foreground="#FF777777" TextWrapping="Wrap"
                           Text="Uncheck Lock to drag the panel and use the gold bottom-right resize handle. Re-lock when finished; position and size are saved."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="8" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Connection" FontWeight="SemiBold"/>
                <TextBlock x:Name="ConnectionStatus" Grid.Column="1" Text="Starting…" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2" Text="Target" FontWeight="SemiBold"/>
                <TextBlock x:Name="TargetStatus" Grid.Row="2" Grid.Column="1" Text="—" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="4" Text="NPC database" FontWeight="SemiBold"/>
                <TextBlock x:Name="DatabaseStatus" Grid.Row="4" Grid.Column="1" Text="Starting…" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
