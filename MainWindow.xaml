<Window x:Class="EQMobOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQ Mob Overlay"
        Width="350" Height="190"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False">
    <Window.Resources>
        <Style x:Key="ResistBadge" TargetType="Border">
            <Setter Property="Height" Value="52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style x:Key="ResistIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFD5CCB9"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="ResistValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Border x:Name="PanelRoot"
            Background="#E8141718" BorderBrush="#FF8E7752" BorderThickness="1"
            CornerRadius="3" Padding="10"
            MouseLeftButtonDown="PanelRoot_MouseLeftButtonDown"
            MouseMove="PanelRoot_MouseMove"
            MouseLeftButtonUp="PanelRoot_MouseLeftButtonUp">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="7"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TargetName" Text="Waiting for EverQuest…"
                               FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="#FFF0E7D5"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TargetSubline" Text=""
                               FontFamily="Segoe UI" FontSize="10" Foreground="#FFAAA18F" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#CC242829" BorderBrush="#FF5E594F" BorderThickness="1"
                        CornerRadius="3" Padding="7,3" Margin="10,0,0,0" VerticalAlignment="Top">
                    <TextBlock x:Name="DistanceText" Text="-- u" FontFamily="Consolas" FontSize="12" Foreground="#FFFFFFFF"/>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HpText" Text="HP --%" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#FFE7E1D7"/>
                <TextBlock x:Name="EstimatedHpText" Grid.Column="1" Text="~ -- / --" FontFamily="Consolas" FontSize="11" Foreground="#FFC8C0B2"/>
            </Grid>

            <Border x:Name="HealthTrack" Grid.Row="4" Height="9" Background="#FF2B2D2D" BorderBrush="#FF57534A" BorderThickness="1" CornerRadius="1">
                <Grid HorizontalAlignment="Left" ClipToBounds="True">
                    <Border x:Name="HealthFill" Height="7" HorizontalAlignment="Left" Background="#FF8C3C32" CornerRadius="1"/>
                </Grid>
            </Border>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ResistBadge}" Background="#FF43354F" BorderBrush="#FF85709A">
                    <Grid><TextBlock Text="✦" Style="{StaticResource ResistIcon}"/><TextBlock x:Name="MRText" Text="--" Style="{StaticResource ResistValue}"/></Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ResistBadge}" Background="#FF284653" BorderBrush="#FF6B93A5">
                    <Grid><TextBlock Text="❄" Style="{StaticResource ResistIcon}"/><TextBlock x:Name="CRText" Text="--" Style="{StaticResource ResistValue}"/></Grid>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource ResistBadge}" Background="#FF4D4730" BorderBrush="#FF91845B">
                    <Grid><TextBlock Text="☠" Style="{StaticResource ResistIcon}"/><TextBlock x:Name="DRText" Text="--" Style="{StaticResource ResistValue}"/></Grid>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource ResistBadge}" Background="#FF552F29" BorderBrush="#FFA46B5D">
                    <Grid><TextBlock Text="♨" Style="{StaticResource ResistIcon}"/><TextBlock x:Name="FRText" Text="--" Style="{StaticResource ResistValue}"/></Grid>
                </Border>
                <Border Grid.Column="8" Style="{StaticResource ResistBadge}" Background="#FF304A35" BorderBrush="#FF729079">
                    <Grid><TextBlock Text="☣" Style="{StaticResource ResistIcon}"/><TextBlock x:Name="PRText" Text="--" Style="{StaticResource ResistValue}"/></Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>

</Window>
